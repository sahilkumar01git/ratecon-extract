# Required: API key for your OpenAI-compatible provider
OPENAI_API_KEY=

# Exact model id. For reproducible evaluation, pin a dated version
# (docs/EVAL.md §3) instead of relying on the moving alias:
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, ...).
# Leave EMPTY for the official OpenAI API:
OPENAI_BASE_URL=

OPENAI_TIMEOUT_S=30

# Set false only if your provider rejects strict structured outputs.
# The pipeline also degrades automatically when that happens.
OPENAI_STRICT=true
